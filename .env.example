# ====================================================
# AnnSeva - Environment Configuration File
# Copy this file to .env and configure your variables
# ====================================================

# Secret key for session security (change in production)
SECRET_KEY=annseva-secret-key-college-project-2026

# Set this on hosted platforms (Render PostgreSQL, for example).
# When present, it takes priority over the local MySQL/SQLite settings.
DATABASE_URL=

# Database Configuration (MySQL)
# Leave password blank if default XAMPP/MySQL has no password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=annseva_db

# Auto fallback to SQLite if local MySQL is not reachable: True or False
USE_SQLITE_FALLBACK=True

# Google Maps JavaScript API Key (Optional)
# Get a free key at: https://console.cloud.google.com/
# Leave empty to use built-in Leaflet / interactive demo map
GOOGLE_MAPS_API_KEY=

# Email Notification Settings (Optional / Demo)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@annseva.org

# Local development only; keep false in production.
FLASK_DEBUG=False
